# ---------------------------------------------------------------------------
# Скопируй в .env и заполни. Все значения опциональны, кроме SHORTS_SECRET_KEY.
# ---------------------------------------------------------------------------

# Ключ шифрования учётных данных площадок (Fernet). Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SHORTS_SECRET_KEY=

# Куда складывать исходники, нарезки и рендеры
SHORTS_STORAGE_DIR=./storage

# Путь к ffmpeg/ffprobe. Если пусто — ищем в PATH, затем в ./tools/ffmpeg/bin
SHORTS_FFMPEG_PATH=
SHORTS_FFPROBE_PATH=

# Сколько задач воркер выполняет параллельно
SHORTS_WORKER_CONCURRENCY=2

# --- STT ---
# Локальный faster-whisper
SHORTS_WHISPER_MODEL=large-v3
SHORTS_WHISPER_DEVICE=cuda
SHORTS_WHISPER_COMPUTE_TYPE=float16
# Облачный fallback: openai | deepgram | none
SHORTS_STT_FALLBACK=openai

# --- LLM ---
# anthropic | openai | ollama
SHORTS_LLM_PROVIDER=anthropic
SHORTS_LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# AITunnel — шлюз к GPT, Claude, DeepSeek и прочим по одному ключу.
# Работает из России, где официальные API недоступны. Ключ вида sk-aitunnel-...
# Каталог моделей: https://aitunnel.ru/docs/models
AITUNNEL_API_KEY=
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1
AITUNNEL_MODEL=gpt-4o
AITUNNEL_STT_MODEL=whisper-1
DEEPGRAM_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- YouTube (Google Cloud Console → OAuth client, тип Desktop app) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- TikTok (TikTok for Developers → Manage apps → Content Posting API) ---
# Ключ называется client key, а не client id. Приложение заводить типом Desktop:
# для него разрешён адрес возврата http://127.0.0.1:8000/api/accounts/tiktok/callback,
# и внешний домен не нужен. Нужны scope video.upload (черновики) и video.publish
# (сразу в профиль). Пошагово — в docs/legal/README.md.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Права запрашиваем ровно те, что одобрены проверкой приложения. По умолчанию
# только черновики. Когда одобрят публикацию в профиль, допиши video.publish.
TIKTOK_SCOPES=user.info.basic,video.upload
# Пусто — http://127.0.0.1:8000/api/accounts/tiktok/callback. Заполнять только
# если в приложении записан другой адрес: TikTok сверяет их посимвольно, и
# localhost с 127.0.0.1 для него не одно и то же.
TIKTOK_REDIRECT_URI=

# --- Instagram, способ 1: Graph API (Meta App, Business-аккаунт) ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Публичный базовый URL, с которого Meta сможет скачать готовый ролик.
# Обязателен для публикации Reels через Graph API — файл напрямую он не принимает.
SHORTS_PUBLIC_BASE_URL=

# --- Instagram, способ 2: логин и пароль (обычный аккаунт) ---
# Читает только scripts/ig_publish.py. Аккаунты, подключённые в панели,
# хранят свои данные в базе зашифрованными, и эти переменные им не нужны.
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
# Секрет двухфакторной аутентификации (base32) — тот же, что в приложении-
# аутентификаторе. Если задан, коды генерируются сами.
INSTAGRAM_TOTP_SEED=
# http://user:pass@host:port. Держи адрес постоянным: смена IP между запусками —
# верный способ получить требование подтвердить вход.
INSTAGRAM_PROXY=
# Cookie sessionid из браузера. Запасной вход, когда Instagram упёрся в проверку:
# её уже прошёл браузер. Живёт до выхода из аккаунта в том же браузере.
INSTAGRAM_SESSIONID=

# --- телеграм-бот ---
# Токен от @BotFather. Пусто — бот не запускается.
SHORTS_TELEGRAM_BOT_TOKEN=8881413207:AAEMmyj-WXDnYjIHqZWjiOUBqWG-ddSeGKw
# Кому можно им пользоваться: id через запятую. Свой id покажет @userinfobot.
# Пустой список = бот отвечает всем отказом.
SHORTS_TELEGRAM_ALLOWED_CHATS=1
